# Copy to `.env` next to compose.yaml and fill in. Never commit the filled copy.

# catalogue | observations | observations-local | demo-twin
OPENBODY_MODE=catalogue

# Loopback port the proxy forwards to.
OPENBODY_PORT=8797

# --- catalogue mode ---------------------------------------------------------
# Host directory of BodyModel descriptors, mounted read-only into the container.
# Every descriptor must declare applicability.subject = "subject:catalogue";
# the host refuses to start rather than publish a real subject identifier.
# Produce them with: python tools/make_catalogue.py --out DIR DESCRIPTOR...
OPENBODY_MODEL_DIRECTORY_HOST=./models

# --- observations mode ------------------------------------------------------
# The authorized ProvidEHR origin. HTTPS is required for any non-loopback host,
# and the URL may carry no credentials, query or fragment.
OPENBODY_SOURCE_URL=
# Host path to a file holding the bearer token, <= 8192 bytes, mode 0400.
OPENBODY_SOURCE_TOKEN_FILE_HOST=./secrets/source-token
# The single tenant and EHR this instance is bound to. Every resolved version
# outside this scope is rejected.
OPENBODY_SOURCE_TENANT=
OPENBODY_SOURCE_EHR=

# --- observations-local mode ------------------------------------------------
# Ingestion with no clinical API to reach: a directory of admitted clinical
# version documents, verified at startup exactly as an API response is verified.
# The file system becomes the trust boundary, so mount it read-only and treat
# write access to it as equivalent to admission authority.
# OPENBODY_SOURCE_DIRECTORY_HOST=./observations
# OPENBODY_ACCEPT_LOCAL_SOURCE=yes
# OPENBODY_SOURCE_TENANT= and OPENBODY_SOURCE_EHR= above still bind the instance.

# --- demo-twin mode ---------------------------------------------------------
# Serves the bundled `subject:local-demo` fixture as a complete BodyState.
# Local development only; requires this explicit opt-in.
# OPENBODY_ACCEPT_DEMO_TWIN=yes
