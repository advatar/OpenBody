  },
  "semantics": {
    "annotations": "$schema, $id, title and description have no validation effect, but they must be recognized. $schema must equal the dialect above.",
    "$ref": "local: a JSON Pointer fragment into the same document ('#/$defs/...', '#/properties/...'). external: exactly the absolute id https://openbody.dev/schemas/whole-person-observation/1.0 plus a pointer fragment, resolved against the bundled observation schema file. No network retrieval. Any other external reference is refused.",
    "type": "'integer' accepts any number with a zero fractional part (so 300.0 is an integer, per JSON Schema). 'number' accepts integers and floats. A type array such as ['string','null'] means any of them.",
    "const/enum": "JSON equality: numbers compare by mathematical value (1 equals 1.0), and strings compare by code point with no normalization.",
    "uniqueItems": "No two items are JSON-equal (deep equality with the numeric rule above; object key order is irrelevant).",
    "pattern": "ECMA-262 regular expression, matched anywhere in the string (unanchored search). The v1 patterns are anchored. Every pattern used is listed in 'patterns'.",
    "minLength/maxLength": "Counted in Unicode scalar values (code points), not UTF-16 code units or bytes.",
    "minItems": "The number of array items, at least the given count.",
    "required/properties/items": "Standard 2020-12 applicator and assertion semantics. 'items' applies to every array item (no prefixItems in v1).",
    "minimum/exclusiveMinimum/exclusiveMaximum": "Numeric comparison by mathematical value.",
    "if/then/else": "If 'if' validates, 'then' applies; otherwise 'else' applies. A missing branch is always valid. The result of 'if' itself never fails the instance.",
    "allOf/anyOf/oneOf/not": "Standard: all / at least one / exactly one subschema validates; not inverts.",
    "additionalProperties": "false: any property not listed in 'properties' fails. A schema: additional properties must validate against it.",
    "format:date-time": "RFC 3339 section 5.6 date-time with a mandatory offset (Z or +hh:mm/-hh:mm) and 'T' as separator (lower-case 't' and 'z' are allowed as in RFC 3339). Calendar-valid dates. Seconds 00-59: second 60 is refused (the reference refuses leap seconds, and a native validator must match it). Any number of fraction digits. Formats are assertions, not annotations: an invalid value fails.",
    "format:uri": "RFC 3986 'URI' production: an absolute URI with a scheme, optional query and fragment, and no whitespace. A relative or network-path reference is refused. Percent-encoding is allowed. Formats are assertions.",
    "time_comparison": "Not a schema keyword, but required for identical assembly: the assembler compares date-times as instants at microsecond precision, and fraction digits beyond six are truncated."
  },
  "patterns": [
    "^ob://[a-z0-9._-]+/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$",
    "^sha256:[a-f0-9]{64}$"
  ],
  "fail_closed": [
    "A validator MUST refuse to load a schema that uses a keyword, format or reference kind outside required_vocabulary.",
    "A validator MUST NOT treat a format it cannot check as an annotation.",
    "A validator that cannot implement an item MUST report the instance as not validated. It MUST NOT report it as valid.",
    "The Python reference applies the same rule (whole_person._require_supported_vocabulary, error code schema_vocabulary_unsupported)."
  ],
