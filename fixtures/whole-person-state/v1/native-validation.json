{
  "vocabulary_version": "openbody.whole-person-native-validation/1.0",
  "description": "The exact JSON Schema vocabulary that a native validator must implement to validate the whole-person contract v1 schemas without weakening the contract identity (owner decision 2 on #30). There is no flattened or native-subset profile. A validator that does not implement every item below MUST refuse to validate (fail closed). It must not skip the constraint.",
  "dialect": "https://json-schema.org/draft/2020-12/schema",
  "schemas": [
    {
      "id": "https://openbody.dev/schemas/whole-person-observation/1.0",
      "file": "schemas/whole-person-observation.schema.json"
    },
    {
      "id": "https://openbody.dev/schemas/whole-person-state/1.0",
      "file": "schemas/whole-person-state.schema.json"
    }
  ],
  "required_vocabulary": {
    "keywords": [
      "$defs",
      "$id",
      "$ref",
