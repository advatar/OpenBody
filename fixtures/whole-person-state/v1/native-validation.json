      "minLength",
      "minimum",
      "not",
      "oneOf",
      "pattern",
      "properties",
      "required",
      "then",
      "title",
      "type",
      "uniqueItems"
    ],
    "formats": [
      "date-time",
      "uri"
    ],
    "refs": [
      "external",
      "local"
    ]
  },
  "per_schema": {
    "whole-person-observation": {
