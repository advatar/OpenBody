PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ilxtr: <http://uri.interlex.org/tgbugs/uris/readable/>
SELECT DISTINCT ?population ?relation ?anatomy ?species
WHERE {
  VALUES ?relation { ilxtr:hasOrganTarget }
  VALUES ?anatomy { <http://purl.obolibrary.org/obo/UBERON_0001556> }
  ?population ?relation ?anatomy .
  OPTIONAL { ?population rdfs:subClassOf [ owl:onProperty ilxtr:hasInstanceInTaxon ; owl:someValuesFrom ?species ] }
}
