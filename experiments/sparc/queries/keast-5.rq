PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ilxtr: <http://uri.interlex.org/tgbugs/uris/readable/>
SELECT DISTINCT ?population ?relation ?filler_relation ?anatomy ?species ?metadata_predicate ?metadata_value
WHERE {
  VALUES ?population { ilxtr:neuron-type-keast-5 }
  ?population owl:equivalentClass/owl:intersectionOf/rdf:rest*/rdf:first ?restriction .
  ?restriction owl:onProperty ?relation ; owl:someValuesFrom ?filler .
  { FILTER(isIRI(?filler)) BIND(?filler AS ?anatomy) }
  UNION
  { ?filler owl:onProperty ?filler_relation ; owl:someValuesFrom ?anatomy . FILTER(isIRI(?anatomy)) }
  OPTIONAL { ?population rdfs:subClassOf [ owl:onProperty ilxtr:hasInstanceInTaxon ; owl:someValuesFrom ?species ] }
  OPTIONAL { ?population ?metadata_predicate ?metadata_value . FILTER(isIRI(?metadata_value) || isLiteral(?metadata_value)) }
  
}
