{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbody.dev/schemas/intervention-observation/2.0",
  "title": "OpenBody intervention source observation",
  "description": "A consented, patient-bound source observation of an intervention. It is not an OpenBody-derived assertion, diagnosis, or treatment recommendation. Declarations in it (subject binding, consent, raw-signal attestation) are the producer's and must be verified by the receiver.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_class",
    "observation_id",
    "subject",
    "subject_binding",
    "scope",
    "source",
    "intervention",
    "observed_measurements",
    "evidence",
    "disclosure",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "openbody.intervention-observation/2.0"
    },
    "projection_class": {
      "const": "source_observation"
    },
    "observation_id": {
      "$ref": "#/$defs/Token"
    },
    "subject": {
      "$ref": "#/$defs/Token"
    },
    "subject_binding": {
      "$ref": "#/$defs/SubjectBinding"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Coordinate"
      }
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "intervention": {
      "$ref": "#/$defs/Intervention"
    },
    "observed_measurements": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/Measurement"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      }
    },
    "user_response": {
      "$ref": "#/$defs/UserResponse"
    },
    "disclosure": {
      "$ref": "#/$defs/Disclosure"
    },
    "claim_boundary": {
      "$ref": "#/$defs/ClaimBoundary"
    }
  },
  "$defs": {
    "Token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/-]{0,199}$",
      "description": "An opaque identifier. No whitespace, so it cannot carry prose."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "URI": {
      "type": "string",
      "format": "uri",
      "maxLength": 500
    },
    "Coordinate": {
      "type": "string",
      "pattern": "^ob://[a-z0-9._-]+/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+(?:\\?[A-Za-z0-9._~!$&'()*+,;=:@%/?-]+)?$"
    },
    "SubjectBinding": {
      "type": "object",
      "additionalProperties": false,
      "description": "The producer's declaration that an issuer verified this subject binding. The receiver verifies it independently.",
      "required": [
        "status",
        "binding_ref",
        "issuer",
        "verified_at",
        "revocation_ref",
        "proof_digest"
      ],
      "properties": {
        "status": {
          "const": "verified"
        },
        "binding_ref": {
          "$ref": "#/$defs/URI"
        },
        "issuer": {
          "$ref": "#/$defs/URI"
        },
        "verified_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "revocation_ref": {
          "$ref": "#/$defs/URI"
        },
        "proof_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_id",
        "app_version"
      ],
      "properties": {
        "app_id": {
          "$ref": "#/$defs/Token"
        },
        "app_version": {
          "$ref": "#/$defs/Token"
        }
      }
    },
    "DoseDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "enum": [
            "duration",
            "frequency",
            "pulse_width",
            "current_amplitude",
            "intensity_setting",
            "breathing_rate",
            "repetitions",
            "temperature",
            "illuminance"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "status": {
          "enum": [
            "planned",
            "observed",
            "patient_reported",
            "unavailable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "planned",
                  "observed",
                  "patient_reported"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value",
              "unit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "unit"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "duration"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "s"
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "frequency"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "Hz"
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "pulse_width"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "us"
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "current_amplitude"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "mA"
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "intensity_setting"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "1"
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "breathing_rate"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "/min"
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "repetitions"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "{count}"
              },
              "value": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "temperature"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "Cel"
              },
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "illuminance"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "lx"
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "Device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "connectivity"
      ],
      "properties": {
        "manufacturer": {
          "$ref": "#/$defs/Token"
        },
        "model": {
          "$ref": "#/$defs/Token"
        },
        "connectivity": {
          "enum": [
            "none",
            "bluetooth",
            "other",
            "unknown"
          ]
        }
      }
    },
    "Intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intervention_id",
        "family",
        "started_at",
        "ended_at",
        "completion",
        "delivery_mode",
        "dose"
      ],
      "properties": {
        "intervention_id": {
          "$ref": "#/$defs/Token"
        },
        "family": {
          "enum": [
            "neuromodulation",
            "respiratory",
            "biofeedback",
            "mind_body",
            "thermal",
            "physical",
            "sensory",
            "circadian",
            "clinical",
            "other"
          ]
        },
        "protocol_id": {
          "$ref": "#/$defs/Token"
        },
        "protocol_version": {
          "$ref": "#/$defs/Token"
        },
        "started_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "ended_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "completion": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "delivery_mode": {
          "enum": [
            "manual",
            "app_guided",
            "app_controlled",
            "clinician_directed",
            "self_reported"
          ]
        },
        "device": {
          "$ref": "#/$defs/Device"
        },
        "dose": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/DoseDimension"
          }
        }
      }
    },
    "Measurement": {
      "type": "object",
      "additionalProperties": false,
      "description": "One value per metric and phase. `not_observed` says a value was expected but none exists; it never carries a value.",
      "required": [
        "phase",
        "metric",
        "status"
      ],
      "properties": {
        "phase": {
          "enum": [
            "before",
            "end",
            "follow_up"
          ]
        },
        "metric": {
          "enum": [
            "heart_rate",
            "resting_heart_rate",
            "hrv_sdnn",
            "respiratory_rate",
            "sleep_duration",
            "step_count",
            "eeg_delta_relative_power",
            "eeg_theta_relative_power",
            "eeg_alpha_relative_power",
            "eeg_beta_relative_power",
            "eeg_gamma_relative_power"
          ]
        },
        "status": {
          "enum": [
            "observed",
            "not_observed"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "source_ref": {
          "$ref": "#/$defs/URI"
        },
        "origin": {
          "enum": [
            "consumer_device",
            "medical_device",
            "app_computed",
            "patient_reported"
          ]
        },
        "reason": {
          "enum": [
            "no_sample",
            "device_not_worn",
            "permission_not_granted",
            "not_collected",
            "source_error"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value",
              "unit",
              "observed_at",
              "source_ref",
              "origin"
            ],
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_observed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "unit"
                  ]
                },
                {
                  "required": [
                    "observed_at"
                  ]
                },
                {
                  "required": [
                    "source_ref"
                  ]
                },
                {
                  "required": [
                    "origin"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "heart_rate"
              }
            },
            "required": [
              "metric",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "/min"
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "resting_heart_rate"
              }
            },
            "required": [
              "metric",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "/min"
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "hrv_sdnn"
              }
            },
            "required": [
              "metric",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "ms"
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "respiratory_rate"
              }
            },
            "required": [
              "metric",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "/min"
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "sleep_duration"
              }
            },
            "required": [
              "metric",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "s"
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "step_count"
              }
            },
            "required": [
              "metric",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "{steps}"
              },
              "value": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "eeg_delta_relative_power"
              }
            },
            "required": [
              "metric",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "1"
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "eeg_theta_relative_power"
              }
            },
            "required": [
              "metric",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "1"
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "eeg_alpha_relative_power"
              }
            },
            "required": [
              "metric",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "1"
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "eeg_beta_relative_power"
              }
            },
            "required": [
              "metric",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "1"
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "eeg_gamma_relative_power"
              }
            },
            "required": [
              "metric",
              "value"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "1"
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      ]
    },
    "EvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "canonical_ref",
        "content_digest",
        "observed_at",
        "contains_raw_signal"
      ],
      "properties": {
        "kind": {
          "enum": [
            "device_sample_summary",
            "derived_analysis",
            "patient_report"
          ]
        },
        "canonical_ref": {
          "$ref": "#/$defs/URI"
        },
        "content_digest": {
          "$ref": "#/$defs/Digest"
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "contains_raw_signal": {
          "const": false,
          "description": "Producer attestation about the referenced artifact."
        },
        "produced_by": {
          "$ref": "#/$defs/Producer"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "derived_analysis"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "produced_by"
            ]
          },
          "else": {
            "not": {
              "required": [
                "produced_by"
              ]
            }
          }
        }
      ]
    },
    "Producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "software_id",
        "software_version"
      ],
      "description": "The non-OpenBody software that derived the referenced analysis.",
      "properties": {
        "software_id": {
          "$ref": "#/$defs/Token"
        },
        "software_version": {
          "$ref": "#/$defs/Token"
        }
      }
    },
    "UserResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "felt",
        "recorded_at"
      ],
      "properties": {
        "felt": {
          "enum": [
            "better",
            "same",
            "worse",
            "not_reported"
          ]
        },
        "recorded_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "Disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "consent_ref",
        "recipient",
        "authorized_at",
        "fields"
      ],
      "properties": {
        "purpose": {
          "enum": [
            "direct_care",
            "care_coordination",
            "self_record"
          ]
        },
        "consent_ref": {
          "$ref": "#/$defs/URI"
        },
        "recipient": {
          "$ref": "#/$defs/URI"
        },
        "authorized_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "intervention",
              "observed_measurements",
              "evidence",
              "user_response"
            ]
          }
        }
      }
    },
    "ClaimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epistemic_class",
        "causal_claim",
        "diagnosis",
        "treatment_recommendation"
      ],
      "properties": {
        "epistemic_class": {
          "const": "observation"
        },
        "causal_claim": {
          "const": false
        },
        "diagnosis": {
          "const": false
        },
        "treatment_recommendation": {
          "const": false
        }
      }
    }
  }
}
