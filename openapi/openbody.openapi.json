{
  "openapi": "3.1.0",
  "info": {"title":"OpenBody HTTP Profile","version":"0.1.0-draft.1"},
  "servers": [{"url":"https://example.org/openbody/v1"}],
  "paths": {
    "/capabilities": {"get":{"operationId":"getCapabilities","responses":{"200":{"description":"Capabilities","content":{"application/json":{"schema":{"type":"object","required":["protocol","versions","capabilities"],"properties":{"protocol":{"const":"openbody"},"versions":{"type":"array","items":{"type":"string"}},"capabilities":{"type":"array","items":{"type":"string"}}}}}}}}}},
    "/state": {"get":{"operationId":"getState","responses":{"200":{"description":"Current body state","content":{"application/json":{"schema":{"$ref":"../schemas/openbody.schema.json#/$defs/BodyState"}}}}}}},
    "/state/{coordinate}": {"get":{"operationId":"getSubsystemState","parameters":[{"name":"coordinate","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Scoped subsystem state","content":{"application/json":{"schema":{"$ref":"../schemas/openbody.schema.json#/$defs/BodySubsystemState"}}}},"404":{"description":"Coordinate not present"}}}},
    "/models": {"get":{"operationId":"listModels","responses":{"200":{"description":"Models","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"../schemas/openbody.schema.json#/$defs/BodyModel"}}}}}}}},
    "/models/{model_id}": {"get":{"operationId":"getModel","parameters":[{"name":"model_id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Model descriptor","content":{"application/json":{"schema":{"$ref":"../schemas/openbody.schema.json#/$defs/BodyModel"}}}},"404":{"description":"Model not found"}}}},
    "/trajectories/{trajectory_id}": {"get":{"operationId":"getTrajectory","parameters":[{"name":"trajectory_id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Body trajectory","content":{"application/json":{"schema":{"$ref":"../schemas/openbody.schema.json#/$defs/BodyTrajectory"}}}},"404":{"description":"Trajectory not found"}}}},
    "/simulations": {"post":{"operationId":"simulate","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["state","perturbation","horizon_seconds","requested_scopes"],"properties":{"state":{"$ref":"../schemas/openbody.schema.json#/$defs/BodyState"},"perturbation":{"$ref":"../schemas/openbody.schema.json#/$defs/Perturbation"},"horizon_seconds":{"type":"integer","minimum":1},"requested_scopes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"../schemas/openbody.schema.json#/$defs/Coordinate"}},"authority_ref":{"type":["string","null"]}}}}}},"responses":{"200":{"description":"Simulation or governed abstention","content":{"application/json":{"schema":{"oneOf":[{"$ref":"../schemas/openbody.schema.json#/$defs/CounterfactualScenario"},{"$ref":"../schemas/openbody.schema.json#/$defs/Abstention"}]}}}},"422":{"description":"Malformed simulation request"}}}},
    "/simulations/{scenario_id}": {"get":{"operationId":"getSimulation","parameters":[{"name":"scenario_id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Stored simulation","content":{"application/json":{"schema":{"$ref":"../schemas/openbody.schema.json#/$defs/CounterfactualScenario"}}}},"404":{"description":"Scenario not found"}}}},
    "/outcomes": {"post":{"operationId":"recordOutcome","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"../schemas/openbody.schema.json#/$defs/ObservedOutcome"}}}},"responses":{"202":{"description":"Outcome accepted","content":{"application/json":{"schema":{"$ref":"../schemas/openbody.schema.json#/$defs/ObservedOutcome"}}}},"422":{"description":"Invalid or unbound outcome"}}}},
    "/calibrations": {"post":{"operationId":"recordCalibration","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"../schemas/openbody.schema.json#/$defs/CalibrationEvent"}}}},"responses":{"202":{"description":"Calibration accepted","content":{"application/json":{"schema":{"$ref":"../schemas/openbody.schema.json#/$defs/CalibrationEvent"}}}},"422":{"description":"Invalid or unbound calibration"}}}}
  }
}
