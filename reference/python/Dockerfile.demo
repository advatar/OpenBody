FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OPENBODY_STORE_PATH=/var/lib/openbody/twin-store.json

WORKDIR /srv/openbody
COPY . ./
RUN python -m pip install --no-cache-dir ./reference/python \
    && useradd --system --uid 10001 --no-create-home openbody \
    && mkdir -p /var/lib/openbody \
    && chown 10001:10001 /var/lib/openbody

USER 10001
EXPOSE 8000
ENTRYPOINT ["python", "-m", "uvicorn", "openbody_ref.demo_host:app", "--host", "0.0.0.0", "--port", "8000"]
